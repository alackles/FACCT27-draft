@incollection{udupa_prompt_2026,
	title = {Prompt ethnography: critical methodology for generative {AI}},
	isbn = {978-1-0353-4220-4},
	shorttitle = {Prompt ethnography},
	url = {https://www.elgaronline.com/edcollchap-oa/book/9781035342204/chapter6.xml},
	abstract = {This chapter proposes “prompt ethnography” as a critical methodology to scrutinize generative AI. Prompt ethnography employs reflexive interactions with generative models and public controversies around model behaviors as empirical touchstones to draw inferences from why AI models say what they say about politically charged topics and interrogate the larger structures of power that define the code, content, and consternations undergirding model outputs. Prompt ethnography stresses that what the models give out emerge from political choices around training data and value alignment rather than embodying a vague and abstract conception of “human communication”—a term that often euphemizes deliberate decisions that lie underneath. Prompt ethnography is, at the same time, political praxis—through the very selection of topics that researchers bring to bear upon the models and the collaborative efforts to envision the means to meaningfully intervene.},
	language = {eng},
	urldate = {2026-10-12},
	booktitle = {Handbook on {Anthropology} and {Artificial} {Intelligence}},
	publisher = {Edward Elgar Publishing},
	author = {Udupa, Sahana},
	month = jul,
	year = {2026},
	note = {Section: Handbook on Anthropology and Artificial Intelligence},
	pages = {88--102},
}

@article{kopf_content_2019,
	title = {Content policies in {Social} {Media} {Critical} {Discourse} {Studies}: {The} invisible hand of social media providers?},
	volume = {11},
	issn = {1752-3079},
	shorttitle = {Content policies in {Social} {Media} {Critical} {Discourse} {Studies}},
	abstract = {This paper complements theoretical and methodological considerations regarding social media in critical discourse studies as it addresses social media content policies as a key contextual element. Specifically, this paper argues that – and why – the exploration of content policies and their enforcement is indispensable when approaching social media platforms and social media data in particular from a critical perspective.



A number of researchers have already begun to identify contextual elements that require particular attention when viewing social media and social media data through a CDS lens. However, social media sites’ content policies, as pervasive contextual element, have not received adequate research attention yet.



Drawing on Computer-Mediated Discourse Analysis (CMDA) and recent developments in Social Media CDS (SM-CDS), this paper first demonstrates the existing gap in research. Then, it contends that social media sites’ content policies deserve more detailed attention in SM-CDS, argues why this is the case and elaborates on the different aspects of content policies and policy enforcement that require examination. After detailed theoretical discussion of this, empirical evidence to support this argument is presented in the form of a case study of Wikipedia and Wikipedia data.},
	number = {1},
	journal = {Critical Approaches to Discourse Analysis across Disciplines (CADAAD)},
	author = {Kopf, Susanne},
	year = {2019},
	pages = {1--19},
}

