@inproceedings{santurkar_whose_2023,
	title = {Whose {Opinions} {Do} {Language} {Models} {Reflect}?},
	issn = {2640-3498},
	url = {https://proceedings.mlr.press/v202/santurkar23a.html},
	abstract = {Language models (LMs) are increasingly being used in open-ended contexts, where the opinions they reflect in response to subjective queries can have a profound impact, both on user satisfaction, and shaping the views of society at large. We put forth a quantitative framework to investigate the opinions reflected by LMs – by leveraging high-quality public opinion polls. Using this framework, we create OpinionQA, a dataset for evaluating the alignment of LM opinions with those of 60 US demographic groups over topics ranging from abortion to automation. Across topics, we find substantial misalignment between the views reflected by current LMs and those of US demographic groups: on par with the Democrat-Republican divide on climate change. Notably, this misalignment persists even after explicitly steering the LMs towards particular groups. Our analysis not only confirms prior observations about the left-leaning tendencies of some human feedback-tuned LMs, but also surfaces groups whose opinions are poorly reflected by current LMs (e.g., 65+ and widowed individuals).},
	language = {en},
	urldate = {2026-11-03},
	booktitle = {Proceedings of the 40th {International} {Conference} on {Machine} {Learning}},
	publisher = {PMLR},
	author = {Santurkar, Shibani and Durmus, Esin and Ladhak, Faisal and Lee, Cinoo and Liang, Percy and Hashimoto, Tatsunori},
	month = jul,
	year = {2023},
	pages = {29971--30004},
}

@misc{li_disentangling_2026,
	title = {Disentangling {Intent} from {Role}: {Adversarial} {Self}-{Play} for {Persona}-{Invariant} {Safety} {Alignment}},
	shorttitle = {Disentangling {Intent} from {Role}},
	url = {http://arxiv.org/abs/2605.01899},
	doi = {10.48550/arXiv.2605.01899},
	abstract = {The growing capabilities of large language models (LLMs) have driven their widespread deployment across diverse domains, even in potentially high-risk scenarios. Despite advances in safety alignment techniques, current models remain vulnerable to emergingpersona-based jailbreak attacks. Existing research on persona-based jailbreak has primarily focused on attack iterations, yet it lacks systemic and mechanistic constraints on the defense side. To address this challenge, we propose PersonaInvariant Alignment (PIA), an adversarial self-play framework that achieves co-evolution through Persona Lineage Evolution (PLE) on the attack side and Persona-Invariant Consistency Learning (PICL) on the defense side. Theoretically, PICL is grounded in thestructural separation hypothesis, using a unilateral KL-divergence constraint to enable the structural decoupling of safety decisions from persona context, thereby maintaining safe behavior under persona-based jailbreak attacks. Experimental results demonstrate that PLE efficiently explores high-risk persona spaces by leveraging lineage-based credit propagation. Meanwhile, the PICL defense method significantly reduces the Attack Success Rate (ASR) while preserving the model’s general capability, thereby validating the superiority and robustness of this alignment paradigm. Codes are available at this https URL.},
	language = {en},
	urldate = {2026-11-03},
	publisher = {arXiv},
	author = {Li, Jiajia and Wen, Xiaoyu and Ma, Zhongtian and Hu, Shuyue and Zhang, Qiaosheng and Wang, Zhen},
	month = may,
	year = {2026},
	note = {arXiv:2605.01899 [cs.AI]},
	keywords = {Computer Science - Artificial Intelligence},
}

@article{qiu_personabreak_2026,
	title = {{PersonaBreak}: inducing low-safety personas for automated {LLM} jailbreaking},
	volume = {82},
	issn = {1573-0484},
	shorttitle = {{PersonaBreak}},
	url = {https://doi.org/10.1007/s11227-026-08954-z},
	doi = {10.1007/s11227-026-08954-z},
	abstract = {As large language models (LLMs) are increasingly deployed in real-world applications, automated jailbreak generation becomes essential for auditing safety vulnerabilities and guiding model improvement. Existing automated jailbreak methods treat the model’s safety mechanism as a static barrier, obfuscating malicious intent at the surface level without understanding why contextual factors modulate refusal behavior. To address this gap, we propose PersonaBreak, an automated jailbreak framework grounded in implicit persona induction. Unlike explicit role-play injection, PersonaBreak formulates jailbreaking as a persona-switching problem: it constructs immersive first-person professional narratives that induce the target model to adopt a low-safety expert persona, thereby suppressing the internal safety state. The framework follows a two-stage pipeline—automated persona generation that embeds harmful content within coherent expert narratives, and an adaptive multi-turn fallback mechanism that anchors the model in this persona before delivering the harmful request. Evaluated on AdvBench, HarmBench, and JailbreakBench across five mainstream LLMs including GPT-5 Mini and DeepSeek-V3.2, PersonaBreak achieves an average attack success rate of 75\%, outperforming the strongest baseline by approximately 9 percentage points, with an average of 2 interaction rounds per attack. Mechanistic analysis on two open-weight models, combining representational probing with causal interventions, supports the persona-switching hypothesis: implicit persona induction suppresses the model’s internal refusal direction, and steering along this direction causally restores refusal behavior, indicating that successful jailbreaking is driven by internal state shifts rather than mere heuristic evasion. We note that efficacy varies across model safety-training levels, an important direction for future work.},
	language = {en},
	number = {16},
	urldate = {2026-11-03},
	journal = {The Journal of Supercomputing},
	author = {Qiu, Lv-Qing and Xie, Hong and Kang, Qian and Chen, Jian-Neng},
	month = oct,
	year = {2026},
	keywords = {AI alignment, Black-box attack, Jailbreak attack, LLM safety},
	pages = {815},
}

@article{placani_anthropomorphism_2024,
	title = {Anthropomorphism in {AI}: hype and fallacy},
	volume = {4},
	issn = {2730-5953, 2730-5961},
	shorttitle = {Anthropomorphism in {AI}},
	url = {https://link.springer.com/10.1007/s43681-024-00419-4},
	doi = {10.1007/s43681-024-00419-4},
	abstract = {This essay focuses on anthropomorphism as both a form of hype and fallacy. As a form of hype, anthropomorphism is shown to exaggerate AI capabilities and performance by attributing human-like traits to systems that do not possess them. As a fallacy, anthropomorphism is shown to distort moral judgments about AI, such as those concerning its moral character and status, as well as judgments of responsibility and trust. By focusing on these two dimensions of anthropomorphism in AI, the essay highlights negative ethical consequences of the phenomenon in this field.},
	language = {en},
	number = {3},
	urldate = {2026-11-02},
	journal = {AI and Ethics},
	author = {Placani, Adriana},
	month = aug,
	year = {2024},
	pages = {691--698},
}

@inproceedings{bickmore_relational_2001,
	address = {Seattle Washington USA},
	title = {Relational agents: a model and implementation of building user trust},
	isbn = {978-1-58113-327-1},
	shorttitle = {Relational agents},
	url = {https://dl.acm.org/doi/10.1145/365024.365304},
	doi = {10.1145/365024.365304},
	abstract = {Building trust with users is crucial in a wide range of applications, such as financial transactions, and some minimal degree of trust is required in all applications to even initiate and maintain an interaction with a user. Humans use a variety of relational conversational strategies, including small talk, to establish trusting relationships with each other. We argue that such strategies can also be used by interface agents, and that embodied conversational agents are ideally suited for this task given the myriad cues available to them for signaling trustworthiness. We describe a model of social dialogue, an implementation in an embodied conversation agent, and an experiment in which social dialogue was demonstrated to have an effect on trust, for users with a disposition to be extroverts.},
	language = {en},
	urldate = {2026-11-02},
	booktitle = {Proceedings of the {SIGCHI} {Conference} on {Human} {Factors} in {Computing} {Systems}},
	publisher = {ACM},
	author = {Bickmore, Timothy and Cassell, Justine},
	month = mar,
	year = {2001},
	pages = {396--403},
}

@article{campbell_relational_2009,
	title = {Relational {Agents}: {A} {Critical} {Review}},
	volume = {1},
	issn = {1875323X},
	shorttitle = {Relational {Agents}},
	url = {http://www.bentham-open.org/pages/content.php?TOVRJ/2009/00000001/00000001/1TOVRJ.SGM},
	doi = {10.2174/1875323X00901010001},
	abstract = {Relationships between people who meet in virtual worlds are common and these relationships can be long term, in some cases lasting a life-time. Although relationships formed in virtual worlds have invited a lot of recent interest, surprisingly little work has been done on developing computer agents and non-player characters that can actively participate in such relationships. The focus of this review is relational agents, agents that can build long term socioemotional relationships with users. In virtual worlds, such agents are just starting to emerge; they are more common in other environments but remain few and far between. This review critically assesses the progress of relational agent development and research since their inception in 2005, proposes new areas of research and considers the potential for their exploitation in virtual worlds.},
	language = {en},
	number = {1},
	urldate = {2026-11-02},
	journal = {The Open Virtual Reality Journal},
	author = {Campbell, Robert H. and Grimshaw, Mark N. and Green, Gillian M.},
	month = apr,
	year = {2009},
	pages = {1--7},
}

@article{oh_artificial_2026,
	title = {Artificial {Intelligence} {Chatbots} as {Relational} {Agents}: {A} {Systematic} {Review} of {Human}–{AI} {Chatbot} {Relationships}},
	issn = {1044-7318, 1532-7590},
	shorttitle = {Artificial {Intelligence} {Chatbots} as {Relational} {Agents}},
	url = {https://www.tandfonline.com/doi/full/10.1080/10447318.2026.2648799},
	doi = {10.1080/10447318.2026.2648799},
	abstract = {This study presents a systematic review guided by the human–AI chatbot Relationship (HAIR) Framework of Social Influence to clarify the antecedents of human–AI chatbot relationships and their social influence outcomes. Following PRISMA guidelines, we searched six databases (ACM Digital Library, Web of Science, Scopus, IEEE, EBSCO, and PsycINFO) and identified 16,358 records, of which 68 papers (78 studies) met inclusion criteria. Findings reveal that trust and perceived social support frequently functioned as relational mediators through which chatbots exert social influence. Although chatbot design features were most commonly examined, message-level factors such as empathy and responsiveness showed extensive associations with relational outcomes but remain underexplored. The literature is dominated by short-term experimental designs, inconsistent conceptualizations of key constructs, and Western samples, limiting understanding of long-term and cross-cultural relationship development. This study clarifies the relational processes underlying AI chatbot influence and offers directions for designing more effective human–AI communication.},
	language = {en},
	urldate = {2026-11-02},
	journal = {International Journal of Human–Computer Interaction},
	author = {Oh, Yoo Jung and Hu, Junwen M. and Zhu, Rui and Lim, Jong In and Zhang, Xinyu},
	month = apr,
	year = {2026},
	pages = {1--25},
}

@article{bickmore_establishing_2005,
	title = {Establishing and maintaining long-term human-computer relationships},
	volume = {12},
	issn = {1073-0516, 1557-7325},
	url = {https://dl.acm.org/doi/10.1145/1067860.1067867},
	doi = {10.1145/1067860.1067867},
	abstract = {This research investigates the meaning of “human-computer relationship” and presents techniques for constructing, maintaining, and evaluating such relationships, based on research in social psychology, sociolinguistics, communication and other social sciences. Contexts in which relationships are particularly important are described, together with specific benefits (like trust) and task outcomes (like improved learning) known to be associated with relationship quality. We especially consider the problem of designing for long-term interaction, and define
              relational agents
              as computational artifacts designed to establish and maintain long-term social-emotional relationships with their users. We construct the first such agent, and evaluate it in a controlled experiment with 101 users who were asked to interact daily with an exercise adoption system for a month. Compared to an equivalent task-oriented agent without any deliberate social-emotional or relationship-building skills, the relational agent was respected more, liked more, and trusted more, even after four weeks of interaction. Additionally, users expressed a significantly greater desire to continue working with the relational agent after the termination of the study. We conclude by discussing future directions for this research together with ethical and other ramifications of this work for HCI designers.},
	language = {en},
	number = {2},
	urldate = {2026-11-02},
	journal = {ACM Transactions on Computer-Human Interaction},
	author = {Bickmore, Timothy W. and Picard, Rosalind W.},
	month = jun,
	year = {2005},
	pages = {293--327},
}

